# Container image for packager-api, the web API service (spec phase 4).
# Build from the repository root:
#   docker build -f docker/Dockerfile.webapi -t packager-api .
# Run:
#   docker run -p 8088:8088 packager-api

FROM alpine:3.19 AS builder

# Same toolchain as the root Dockerfile; git + network are needed at
# configure time (oatpp is vendored via FetchContent).
RUN apk add --no-cache \
        bash curl git \
        bsd-compat-headers linux-headers \
        build-base cmake ninja python3

WORKDIR /shaka-packager
COPY . /shaka-packager/
RUN rm -rf build
# -Wno-error=deprecated-declarations: alpine GCC + the vendored abseil
# (lts_20260107) hard-error on upstream's pointer-form absl::MutexLock;
# suppressed here only, keeping upstream sources untouched.
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -G Ninja \
        -DCMAKE_CXX_FLAGS="-Wno-error=deprecated-declarations"
RUN cmake --build build --parallel --target packager packager-api

FROM alpine:3.19
RUN apk add --no-cache libstdc++
COPY --from=builder /shaka-packager/build/packager/packager \
                    /shaka-packager/build/packager/webapi/packager-api \
                    /usr/bin/
# The swagger-ui resource path is baked in at compile time
# (OATPP_SWAGGER_RES_PATH); keep the same absolute path in this image.
COPY --from=builder /shaka-packager/build/_deps/oatpp_swagger-src/res \
                    /shaka-packager/build/_deps/oatpp_swagger-src/res

# API port, API self-metrics port, per-event metrics port pool.
EXPOSE 8088 9090 19100-19199

ENTRYPOINT ["packager-api"]
CMD ["--api_bind_address", "0.0.0.0"]
